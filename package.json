{
  "name": "zshield-mcp",
  "version": "0.1.0",
  "description": "MCP server for agent-initiated shielded ZEC payments under human policy (caps, allow-list, viewing-key audit). Mock chain first.",
  "type": "module",
  "bin": {
    "zshield-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test tests/policy.test.ts tests/pay.test.ts tests/live.test.ts",
    "demo:testnet": "tsx scripts/demo-testnet.ts",
    "demo:mock": "tsx scripts/demo-mock.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
