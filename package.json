{
  "name": "zshield-mcp",
  "version": "0.1.0",
  "description": "MCP server for agent-initiated shielded ZEC payments under human policy (caps, allow-list, viewing-key audit). Mock chain first.",
  "type": "module",
  "bin": {
    "zshield-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node scripts/run-tests.mjs",
    "test:invariants": "node --import tsx --test --test-concurrency=4 tests/invariants/*.test.ts",
    "demo:testnet": "tsx scripts/demo-testnet.ts",
    "demo:mock": "tsx scripts/demo-mock.ts",
    "test:testnet": "node scripts/verify-testnet.mjs",
    "operator": "tsx scripts/operator.ts",
    "test:coverage": "node scripts/run-tests.mjs --experimental-test-coverage"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "stream-chain": "^4.4.1",
    "stream-json": "^3.8.0",
    "yaml": "^2.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
