# Hard max ZEC per single zcash_pay tool call
SPENDING_CAP_ZEC=0.1

# Path to recipient allow-list JSON
ALLOWLIST_PATH=./allowlists/recipients.example.json

# mock (default) or testnet (zingo-cli live adapter). Mainnet is refused.
CHAIN_MODE=mock

# Directory for append-only JSONL audit logs
AUDIT_DIR=./audits

# Required in testnet: generate a unique value with openssl rand -hex 32. Never reuse across deployments.
VIEW_KEY_FINGERPRINT_SALT=dev-only-change-me

# Calls per minute per independent group: payment, status, ordinary reads (1 to 10000)
RATE_LIMIT_PER_MIN=60

# Lifetime JSONL capacity per destination and pool (bytes). Never prune payment state.
AUDIT_MAX_BYTES=67108864
AUDIT_DIAGNOSTIC_MAX_BYTES=67108864
